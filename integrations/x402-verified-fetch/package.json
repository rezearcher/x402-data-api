{
  "name": "@grey-ridge/x402-verified-fetch",
  "version": "0.4.0",
  "description": "Drop-in fetch wrapper for x402-paying agents that independently verifies the on-chain settlement after paying — the full 4-check standard: Transfer reconcile (payTo + amount), EIP-3009 nonce consumed, signed-payload bind, and validity-window. The only x402 client that binds the settlement to the authorization IT signed. Composes @x402/fetch; reads the Base chain itself.",
  "keywords": [
    "x402",
    "x402-fetch",
    "wrapFetchWithPayment",
    "receipt-verify",
    "settlement",
    "onchain",
    "eip-3009",
    "eip3009",
    "base",
    "usdc",
    "ai-agent",
    "agent-payments",
    "micropayments"
  ],
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test test/*.test.mjs",
    "prepare": "tsup"
  },
  "dependencies": {
    "@x402/core": "^2.19.0",
    "@x402/fetch": "^2.19.0"
  },
  "peerDependencies": {
    "@x402/evm": ">=2.15.0"
  },
  "peerDependenciesMeta": {
    "@x402/evm": {
      "optional": true
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rezearcher/x402-data-api.git",
    "directory": "integrations/x402-verified-fetch"
  },
  "homepage": "https://api.greyridgesignals.ai/x402/receipt-verify/preview",
  "devDependencies": {
    "tsup": "^8.3.0",
    "typescript": "^5.7.3"
  }
}
