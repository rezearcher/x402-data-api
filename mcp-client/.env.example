# x402-data-api-mcp configuration
# Copy to .env (`cp .env.example .env`) and adjust as needed.
# The client reads these straight from process.env at startup.

# Base URL of the x402-data-api Worker. Keep the default unless you run
# your own mirror of the service.
WORKER_BASE_URL=https://x402-data-api.sigrunner.workers.dev

# Optional: private key for the x402 wallet used to auto-settle paid tools
# (HTTP 402 responses) via the x402 protocol. Leave empty to run only the
# free/preview tools.
#
# There is no separate wallet-address variable — the wallet address is
# derived from this key. Only set this in .env (never commit a real key).
X402_WALLET_PRIVATE_KEY=
