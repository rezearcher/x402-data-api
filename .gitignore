node_modules/
.wrangler/
.dev.vars
.env
.ruff_cache/
buyer-wallet.json
seed_cdp_pm.js
.mcp-registry-key
.cdp_seed_cooldown.json
.bazaar_refresh_cooldown.json

# rogue literal-tilde worker-session artifact (Hermes $HOME-resolution bug,
# see t_e128cabf) — a worker wrote to a path like "~/.hermes/vpe-keys/..."
# without shell expansion, creating a literal "~" dir instead of $HOME.
/~/

# per-card kanban worktree checkouts (wt/<card_id> branches, managed by
# `git worktree` — content lives in git history, not here; keeping this
# untracked means `git status` on the live repo is always dirty and a
# blind `git clean -fdx` elsewhere could reap in-flight worktrees)
/.worktrees/
data/bazaar_full_*.json

# python bytecode + transient scan logs
scripts/__pycache__/
data/*_scan.log
data/*_demand_lane.log

# scratch area for dependency/install probes (never commit)
.scratch-x402/
# plugin build artifacts + local lockfiles (standalone repos carry their own committed dist)
integrations/*/dist/
integrations/*/package-lock.json

# machine-state sidecars written by .metrics/reconcile_live_revenue.py (not source)
.metrics/.revenue_usd_corrected_timestamp
# The tracked value file is now the repo MIRROR only: the authoritative copy is
# ~/.hermes/data/x402-data-api/metrics/revenue_usd_corrected, which milestone.sh reads
# first (breathing-life/scripts/milestone.sh:201). The cron producer rewrites this repo
# copy every 15 min, so keeping it tracked means the shared main tree is permanently
# dirty and every metrics-touching branch gets a guaranteed merge conflict on a file
# nobody should hand-edit. The file stays on disk, so milestone.sh's fallback still works.
.metrics/revenue_usd_corrected
