# Copy to .dev.vars (gitignored) and fill in for local dev.
# PAY_TO must be a valid EVM address you control.
# On testnet any address works; for mainnet launch use your real Base wallet.
PAY_TO=0x0000000000000000000000000000000000000000

# RapidAPI marketplace rail (optional — leave unset and the bypass stays inert).
# RapidAPI bills the buyer itself and proxies the call to us with this shared secret in
# the X-RapidAPI-Proxy-Secret header. Must match the value in the RapidAPI listing.
# Production: `wrangler secret put RAPIDAPI_PROXY_SECRET` (never commit the real value).
RAPIDAPI_PROXY_SECRET=
